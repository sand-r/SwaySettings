using Gtk 4.0;
using Adw 1;

template $SwaySettingsPulseContent: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "pulse_page";

      child: Box pulse_page {
        spacing: 24;
        orientation: vertical;
        valign: start;

        Adw.PreferencesGroup output_group {
          title: 'Output';

          header-suffix: MenuButton test_button {
            label: 'Test...';
            valign: center;

            styles [
              "flat"
            ]

            popover: Popover {
              child: Box {
                spacing: 8;
                margin-top: 6;
                margin-bottom: 6;
                margin-start: 6;
                margin-end: 6;

                Button test_left_button {
                  label: 'Left';
                  valign: center;
                }

                Button test_right_button {
                  label: 'Right';
                  valign: center;
                }
              };
            };
          };

          Adw.ComboRow output_device_row {
            title: 'Output Device';
          }

          Adw.ComboRow output_profile_row {
            title: 'Configuration';
          }

          Adw.ActionRow {
            title: 'Output Volume';

            [suffix]
            Box {
              spacing: 8;
              valign: center;

              ToggleButton output_mute_toggle {
                icon-name: 'audio-volume-high-symbolic';
                valign: center;

                styles [
                  "flat"
                ]
              }

              Scale output_slider {
                adjustment: Adjustment output_adjustment {
                  page-increment: 10.0;
                  step-increment: 1.0;
                  value: 0;
                  lower: 0;
                  upper: 100.0;
                };

                digits: 0;
                hexpand: true;
              }
            }
          }

          Adw.ActionRow output_balance_row {
            title: 'Balance';

            [suffix]
            Scale output_balance_slider {
              adjustment: Adjustment output_balance_adjustment {
                page-increment: 0.1;
                step-increment: 0.01;
                value: 0;
                lower: -1.0;
                upper: 1.0;
              };

              digits: 2;
              draw-value: false;
              hexpand: true;
            }
          }
        }

        Adw.PreferencesGroup input_group {
          title: 'Input';

          Adw.ComboRow input_device_row {
            title: 'Input Device';
          }

          Adw.ActionRow {
            title: 'Input Volume';

            [suffix]
            Box {
              spacing: 8;
              valign: center;

              ToggleButton input_mute_toggle {
                icon-name: 'audio-input-microphone-symbolic';
                valign: center;

                styles [
                  "flat"
                ]
              }

              Scale input_slider {
                adjustment: Adjustment input_adjustment {
                  page-increment: 10.0;
                  step-increment: 1.0;
                  upper: 100.0;
                };

                digits: 0;
                hexpand: true;
              }
            }
          }
        }

        Adw.PreferencesGroup sink_inputs_group {
          title: 'Applications';

          ListBox levels_listbox {
            selection-mode: none;

            styles [
              "boxed-list"
            ]

            [placeholder]
            Adw.StatusPage {
              icon-name: 'audio-speakers-symbolic';
              title: 'No Applications Playing';

              styles [
                "compact"
              ]
            }
          }
        }
      };
    }

    StackPage {
      name: "error_page";

      child: Adw.StatusPage error_page {
        icon-name: 'audio-volume-muted-symbolic';
        title: 'Sound Unavailable';
        description: 'PulseAudio service is not running';
        vexpand: true;
      };
    }
  };
}
