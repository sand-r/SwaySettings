using Gtk 4.0;
using Adw 1;

template $SwaySettingsTrackpadContent: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "placeholder";

      child: Adw.StatusPage {
        icon-name: 'input-touchpad-symbolic';
        title: 'No Trackpad Detected';
        vexpand: true;
      };
    }

    StackPage {
      name: "page";

      child: Box content_box {
        spacing: 24;
        orientation: vertical;
        valign: start;

        Adw.PreferencesGroup general_group {
          title: 'General';

          Adw.ComboRow state_row {
            title: 'State';
            subtitle: 'Enable or disable trackpad';
          }

          Adw.SwitchRow natural_scroll_row {
            title: 'Natural Scrolling';
            subtitle: 'Scroll content instead of viewport';
          }

          Adw.SwitchRow tap_row {
            title: 'Tap to Click';
            subtitle: 'Tap the trackpad to click';
          }

          Adw.SwitchRow dwt_row {
            title: 'Disable While Typing';
            subtitle: 'Prevent accidental touches while typing';
          }
        }

        Adw.PreferencesGroup scrolling_group {
          title: 'Scrolling';

          Adw.ComboRow scroll_method_row {
            title: 'Scroll Method';
          }

          Adw.ActionRow scroll_factor_row {
            title: 'Scroll Speed';

            [suffix]
            Scale scroll_factor_scale {
              adjustment: Adjustment {
                lower: 0.0;
                upper: 10.0;
                step-increment: 0.1;
                page-increment: 1.0;
                value: 1.0;
              };
              digits: 1;
              draw-value: true;
              hexpand: true;
              valign: center;
            }
          }
        }

        Adw.PreferencesGroup clicking_group {
          title: 'Clicking';

          Adw.ComboRow click_method_row {
            title: 'Click Method';
            subtitle: 'How multi-finger clicks are interpreted';
          }
        }

        Adw.PreferencesGroup speed_group {
          title: 'Pointer Speed';

          Adw.ComboRow accel_profile_row {
            title: 'Acceleration Profile';
          }

          Adw.ActionRow pointer_accel_row {
            title: 'Pointer Speed';

            [suffix]
            Scale pointer_accel_scale {
              adjustment: Adjustment {
                lower: -1.0;
                upper: 1.0;
                step-increment: 0.1;
                page-increment: 0.1;
                value: 0.0;
              };
              digits: 1;
              draw-value: true;
              hexpand: true;
              valign: center;
            }
          }
        }
      };
    }
  };
}
